# ---------------------------------------------------------------------------
# AgentGuard configuration
# ---------------------------------------------------------------------------

# Razorpay TEST MODE keys. If either is absent AgentGuard falls back to a
# clearly-labelled simulated gateway so the demo still runs end to end.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Server-side signing secret for policy signatures, human-approval tokens and
# gateway payload signatures. NEVER expose this to the LLM / agent.
AGENTGUARD_SERVER_SECRET=replace-with-a-long-random-string

# Shared-secret token for administrative actions (approvals, reset, tamper)
AGENTGUARD_ADMIN_TOKEN=ag-admin-demo-token-2026
NEXT_PUBLIC_AGENTGUARD_ADMIN_TOKEN=ag-admin-demo-token-2026

# Optional: override the single-instance snapshot / audit file locations.
# AGENTGUARD_STATE_FILE=./agentguard-state.json
# AGENTGUARD_AUDIT_FILE=./agentguard-audit.json

